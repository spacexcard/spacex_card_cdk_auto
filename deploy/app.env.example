SERVER_HOST=127.0.0.1
SERVER_PORT=9080
SERVER_MODE=release
DB_PATH=/opt/cdk-recharge/data/cdk_recharge.db
WEB_DIR=/opt/cdk-recharge/web
JWT_SECRET=change-me-to-random-32chars-min
JWT_EXPIRATION_HOURS=24
INSTALL_MODE=wizard
# 可选：固定安装令牌；不设则启动日志打印随机 token
# SETUP_BOOTSTRAP_TOKEN=
# 公网域名安装：留空（仅靠 Setup Token）。仅本机装时可写 127.0.0.1,::1
SETUP_ALLOW_CIDRS=
TRUSTED_PROXIES=127.0.0.1
