# 复制为 .push.env 后填写（.push.env 已 gitignore，不会提交）
# cp .push.env.example .push.env

# GitHub 仓库所有者（硬约束：仅 zovocard，push.sh 会校验）
GIT_USER=zovocard

# 仓库
GIT_REPO=zovo_card_cdk_auto

# Personal Access Token（classic，勾选 repo）
# 在此填写：https://github.com/settings/tokens/new
# 切勿把真实 ghp_ token 写进 example 或提交到 git
GIT_PAT=ghp_replace_with_your_token

# 提交显示的作者（硬约束：仅 zovocard / zovo_card）
GIT_AUTHOR_NAME=zovocard
GIT_AUTHOR_EMAIL=zovocard@users.noreply.github.com

# 分支
GIT_BRANCH=master
