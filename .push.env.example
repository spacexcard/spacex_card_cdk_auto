# 复制为 .push.env 后填写（.push.env 已 gitignore，不会提交）
# cp .push.env.example .push.env

# GitHub 用户名 / 组织（仓库所有者）
GIT_USER=spacexcard

# 仓库
GIT_REPO=spacex_card_cdk_auto

# Personal Access Token（classic，勾选 repo）
# 在此填写：https://github.com/settings/tokens/new
# 切勿把真实 ghp_ token 写进本文件或提交到 git
GIT_PAT=ghp_replace_with_your_token

# 提交显示的作者（与推送账号可以不同）
GIT_AUTHOR_NAME=OpenSource Maintainer
GIT_AUTHOR_EMAIL=maintainer@users.noreply.github.com

# 分支
GIT_BRANCH=master
